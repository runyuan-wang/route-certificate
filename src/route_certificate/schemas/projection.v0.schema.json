{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/runyuan-wang/route-certificate/main/src/route_certificate/schemas/projection.v0.schema.json",
  "title": "RouteCertificate named consumer projection v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "canonical_profile",
    "projection_profile",
    "certificate_ref",
    "producer_receipt_ref",
    "included",
    "deferred",
    "ordered_heading_evidence_inventory"
  ],
  "properties": {
    "schema_version": {"const": "routecert.projection.v0"},
    "canonical_profile": {"const": "routecert-canonical-json-v0"},
    "projection_profile": {"const": "routecert-consumer-projection-v0"},
    "certificate_ref": {"$ref": "#/$defs/ref"},
    "producer_receipt_ref": {"$ref": "#/$defs/ref"},
    "included": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "value"],
        "properties": {
          "path": {"$ref": "#/$defs/pointer"},
          "value": {}
        }
      }
    },
    "deferred": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "digest"],
        "properties": {
          "path": {"$ref": "#/$defs/pointer"},
          "digest": {"$ref": "#/$defs/digest"}
        }
      }
    },
    "ordered_heading_evidence_inventory": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["heading", "evidence_refs"],
        "properties": {
          "heading": {"type": "string"},
          "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/id"}}
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "pointer": {"type": "string", "pattern": "^(?:|(?:/(?:[^~/]|~0|~1)*)*)$"},
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "digest"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
