{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/runyuan-wang/route-certificate/main/src/route_certificate/schemas/consumer-validation-receipt.v0.schema.json",
  "title": "RouteCertificate current consumer validation receipt v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "canonical_profile",
    "overall",
    "subject_digests",
    "checks",
    "semantic_limit",
    "receipt_body_separate",
    "digest"
  ],
  "properties": {
    "schema_version": {"const": "routecert.consumer-validation-receipt.v0"},
    "receipt_id": {"const": "current-consumer-validation"},
    "canonical_profile": {"const": "routecert-canonical-json-v0"},
    "overall": {"enum": ["pass", "fail"]},
    "subject_digests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["certificate", "task", "sources", "rubric", "producer_receipt"],
      "properties": {
        "certificate": {"$ref": "#/$defs/nullable_digest"},
        "task": {"$ref": "#/$defs/nullable_digest"},
        "sources": {"$ref": "#/$defs/nullable_digest"},
        "rubric": {"$ref": "#/$defs/nullable_digest"},
        "producer_receipt": {"$ref": "#/$defs/nullable_digest"}
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["structural", "referential", "closure", "artifact", "semantic"],
      "properties": {
        "structural": {"$ref": "#/$defs/check"},
        "referential": {"$ref": "#/$defs/check"},
        "closure": {"$ref": "#/$defs/check"},
        "artifact": {"$ref": "#/$defs/check"},
        "semantic": {"$ref": "#/$defs/check"}
      }
    },
    "semantic_limit": {"const": "not_performed; mechanical validation is not semantic truth"},
    "receipt_body_separate": {"const": true},
    "digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "nullable_digest": {
      "anyOf": [
        {"type": "null"},
        {"$ref": "#/$defs/digest"}
      ]
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "errors"],
      "properties": {
        "status": {"enum": ["pass", "fail", "not_performed"]},
        "errors": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
